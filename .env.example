# CivicBridge local configuration. Copy to .env only if you need to change defaults.
# No secrets belong here: database, storage, LiveKit, session and MFA keys are generated on first start
# into the private Docker volume "civicbridge_secrets" by the init-secrets service.

# Public origin of the web app (frontend/reverse proxy on host port 8084).
CB_PUBLIC_ORIGIN=http://localhost:8084
CB_ALLOWED_ORIGINS=http://localhost:8084,http://127.0.0.1:8084
# Host interface for the web app port. Keep 127.0.0.1 unless you follow docs/VIDEO_SETUP.md.
WEB_BIND_IP=127.0.0.1

# Video (LiveKit). Signalling is proxied through the web origin; media uses TCP 7891 and UDP 50100-50160.
# For other devices on your network or the internet see docs/VIDEO_SETUP.md before changing these.
CB_LIVEKIT_PUBLIC_URL=ws://localhost:8084
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_BIND_IP=127.0.0.1
# Websocket origins the web app's Content-Security-Policy allows (must cover CB_LIVEKIT_PUBLIC_URL).
CB_CSP_CONNECT_EXTRA=ws://localhost:8084 ws://127.0.0.1:8084

# AI mode: rules | mock (default) | ollama (requires: docker compose --profile ollama up -d, then pull a model)
CB_AI_MODE=mock
CB_OLLAMA_MODEL=llama3.2:3b

# Set to true only when serving over HTTPS.
CB_COOKIE_SECURE=false

# Seed synthetic demo tenants, accounts and data on first start.
CB_SEED_DEMO=true

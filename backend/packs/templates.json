{
  "version": "1.0.0",
  "templates": [
    {
      "code": "relocation-il-de",
      "life_event_type": "relocation",
      "name": "Relocate from Israel to Berlin, Germany",
      "origin": "IL",
      "destination": "DE-BE-BER",
      "pack_versions": {"IL": "1.0.0", "DE": "1.0.0"},
      "summary": "A cross-border journey that composes the Israeli and German packs independently. Synthetic, illustrative steps; confirm details with each authority.",
      "jurisdictions": ["IL", "DE-BE-BER"],
      "questions": [
        {"id": "needs_language_course", "type": "boolean", "label": {"en": "Would you like to include a German language course?", "de": "Möchten Sie einen Deutschkurs einplanen?", "he": "האם לכלול קורס גרמנית?"}},
        {"id": "has_employer", "type": "boolean", "label": {"en": "Do you already have a job offer in Germany?", "de": "Haben Sie bereits ein Jobangebot in Deutschland?", "he": "האם יש לך כבר הצעת עבודה בגרמניה?"}}
      ],
      "tasks": [
        {"key": "il-gather-docs", "title": "Gather identity and civil status documents", "description": "Upload your passport and birth certificate to your wallet.", "jurisdiction": "IL", "phase": "evidence", "offset_days": -60,
         "required_evidence": [{"key": "passport", "category": "identity", "label": "Valid passport"}, {"key": "birth_certificate", "category": "civil_status", "label": "Birth certificate"}]},
        {"key": "de-residence-check", "title": "Check residence permit requirements", "description": "Use the Rights Navigator to screen residence requirements. A human case officer decides on any permit.", "jurisdiction": "DE", "phase": "review", "offset_days": -50, "depends_on": ["il-gather-docs"], "requires_human_review": true},
        {"key": "il-certified-copies", "title": "Obtain certified copies with apostille (illustrative)", "description": "Foreign authorities often request certified civil status documents.", "jurisdiction": "IL", "phase": "evidence", "offset_days": -40, "depends_on": ["il-gather-docs"],
         "required_evidence": [{"key": "birth_certificate_apostille", "category": "civil_status", "label": "Certified birth certificate"}]},
        {"key": "il-departure-notice", "title": "Notify Israeli population services of long-term departure", "description": "Prepared as a request to the demo Israeli authority (simulated exchange).", "jurisdiction": "IL", "phase": "coordination", "offset_days": -14, "depends_on": ["il-gather-docs"], "procedure_code": "IL-DEPARTURE-NOTICE"},
        {"key": "de-housing", "title": "Secure housing and the landlord confirmation", "description": "You need the landlord's move-in confirmation to register your address.", "jurisdiction": "DE-BE-BER", "phase": "evidence", "offset_days": -7,
         "required_evidence": [{"key": "landlord_confirmation", "category": "housing", "label": "Landlord confirmation (Wohnungsgeberbestätigung)"}]},
        {"key": "de-registration", "title": "Register your Berlin address", "description": "Illustrative period: within 14 days after moving in. Sent to the demo Berlin registration office (simulated exchange).", "jurisdiction": "DE-BE-BER", "phase": "decision", "offset_days": 14, "depends_on": ["de-housing", "il-gather-docs"], "procedure_code": "DE-BER-ANMELDUNG",
         "required_evidence": [{"key": "passport", "category": "identity", "label": "Valid passport"}, {"key": "landlord_confirmation", "category": "housing", "label": "Landlord confirmation"}]},
        {"key": "de-health-insurance", "title": "Enrol in health insurance", "description": "Proof of health insurance is commonly requested.", "jurisdiction": "DE", "phase": "evidence", "offset_days": 14,
         "required_evidence": [{"key": "health_insurance", "category": "health", "label": "Health insurance confirmation"}]},
        {"key": "de-tax-id", "title": "Receive your tax identification number", "description": "Usually follows address registration.", "jurisdiction": "DE", "phase": "coordination", "working_days_after": 20, "depends_on": ["de-registration"]},
        {"key": "de-social-coordination", "title": "Coordinate social security records between countries", "description": "An interagency handoff to the demo pension liaison office, only with your explicit consent.", "jurisdiction": "DE", "phase": "coordination", "working_days_after": 30, "depends_on": ["de-registration"], "requires_human_review": true, "procedure_code": "DE-SOCIAL-COORD"},
        {"key": "de-employment-contract", "title": "Upload your employment contract", "description": "Needed if your stay is based on employment.", "jurisdiction": "DE", "phase": "evidence", "offset_days": -30, "only_if": {"q": "has_employer", "value": true},
         "required_evidence": [{"key": "employment_contract", "category": "employment", "label": "Employment contract"}]},
        {"key": "de-language-course", "title": "Book a German language course", "description": "Optional step you selected.", "jurisdiction": "DE-BE-BER", "phase": "closure", "offset_days": 60, "only_if": {"q": "needs_language_course", "value": true}}
      ]
    },
